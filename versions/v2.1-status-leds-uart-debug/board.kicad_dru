(version 1)

(rule "Global routing feasibility floor"
  (constraint clearance (min 0.15mm))
  (constraint track_width (min 0.15mm)))

(rule "USB-C fine-pitch escape"
  (condition "A.NetName == 'USB_DP_RAW' || A.NetName == 'USB_DM_RAW' || A.NetName == 'USB_CC1' || A.NetName == 'USB_CC2'")
  (constraint clearance (min 0.15mm))
  (constraint track_width (min 0.15mm)))

(rule "J2 edge-mounted shield tabs"
  (condition "A.Reference == 'J2' && A.Pad_Number == 'SH'")
  (constraint edge_clearance (min 0mm)))
