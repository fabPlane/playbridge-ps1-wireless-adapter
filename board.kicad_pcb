			(rotate 0)
			(scale 1 1)
		)
		(descr "PROVISIONAL nine-position bare male pin array: 4.00 mm pitch, 32.00 mm span, 0.64 x 0.64 mm square contacts, 1.00 mm drills. Contact projects 16.00 mm beyond PCB edge: inner 8.00 mm shell capture/support section plus outer 8.00 mm console mating section. MPN, retention and assembly TBD; coupon required.")
		(property "Reference" "J1"
			(at 0 -4 0)
