			(hide yes)
			(uuid "6f54ee0a-e2b0-4068-aa94-578b9b174e56")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "dc7d5725-a28f-40d9-aca0-021442310b6b")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Pinout" "Console mating view left-to-right: 9 PS_ACK, 8 NC, 7 PS_CLK | 6 PS_ATT, 5 PS_3V5_CONSOLE (measured 3.58 V; intentionally isolated), 4 GND | 3 PS_8V_RAW, 2 PS_CMD, 1 PS_DATA. Pin 5 is a real console logic-supply contact but has no PCB net in this self-powered MVP to prevent backfeed; pin 8 is the only true console NC."
			(at 0 0 0)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "d456ea9a-d2ff-4d45-9d22-07756afd9679")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Orientation" "CONSOLE SIDE faces outward from the board edge. Console mating view left-to-right is pad 9 through pad 1. Contact centers are 0,4,8,12,16,20,24,28,32 mm: continuous uniform 4.00 mm pitch and 32.00 mm pad-9-to-pad-1 span. The visible three console-housing groups are plastic divisions only and do not add contact-center gaps."
			(at 0 0 0)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "9edab3dc-8654-4a67-994f-977443406e9a")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Assembly Note" "MECHANICAL TBD / NOT PRODUCTION RELEASED. A printed 4.00 mm-pitch guide carrying all nine provisional 0.64 x 0.64 mm square contacts was inserted together into a spare original PS1 controller port, validating the nine-pin spacing and insertion concept. Each contact projects 16.00 mm beyond the PCB-edge datum: the inner 8.00 mm is reserved for capture, alignment and lateral support by the future printed nose; only the outermost 8.00 mm is the console mating/insertion section. Exact purchasable pin MPN, tail/retention geometry, plating, production tolerance and assembly method remain TBD. The provisional 1.00 mm holes and 1.70 mm pads are not production-released. The shell must carry mating loads. No donor plug, cable, wires or female socket terminals."
			(at 0 0 0)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "90fca359-471d-4d5a-94e3-5f0c2b2080f1")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Bench Validation" "With ESP32 disconnected and the console powered, J1 pin 5 measured 3.58 V relative to pin 4/GND. Keep pin 5 isolated from board 3V3, USB power and console-derived power paths; never tie it directly to board 3V3."
			(at 0 0 0)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
