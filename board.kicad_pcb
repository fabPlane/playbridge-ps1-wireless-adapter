		(property "Pinout" "Console mating view left-to-right: 9 PS_ACK, 8 NC, 7 PS_CLK | 6 PS_ATT, 5 PS_3V5_RESERVED_NO_CONNECT, 4 GND | 3 PS_8V_RAW, 2 PS_CMD, 1 PS_DATA. Pin 5 and pin 8 are intentionally isolated and have no electrical net."
			(at 0 0 0)
			(unlocked yes)
			(layer "F.Fab")
